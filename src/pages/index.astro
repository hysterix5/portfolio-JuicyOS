---
import Layout from '../layouts/Layout.astro';
import BootScreen from '../components/BootScreen.astro';
import LoginScreen from '../components/LoginScreen.astro';
import Desktop from '../components/Desktop.astro';
import WindowManager from '../components/WindowManager.astro';
import TerminalApp from '../components/apps/TerminalApp.astro';
import FileManagerApp from '../components/apps/FileManagerApp.astro';
import BrowserApp from '../components/apps/BrowserApp.astro';

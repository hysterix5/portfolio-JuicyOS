---
/* Browser App — Links & Social Media */
---

<div class="os-window closed" id="win-browser" data-app="browser" style="width:720px;height:500px;">
  <div class="window-titlebar">
    <div class="window-controls">
      <button class="win-close"><svg viewBox="0 0 12 12" stroke="currentColor" stroke-width="2"><line x1="3" y1="3" x2="9" y2="9"/><line x1="9" y1="3" x2="3" y2="9"/></svg></button>
      <button class="win-minimize"><svg viewBox="0 0 12 12" stroke="currentColor" stroke-width="2"><line x1="2" y1="6" x2="10" y2="6"/></svg></button>
      <button class="win-maximize"><svg viewBox="0 0 12 12" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="8" height="8" rx="1" fill="none"/></svg></button>
    </div>
    <span class="window-title">JuicyBrowser</span>
    <div class="window-title-spacer"></div>
  </div>
  <div class="window-body browser-body">
    <!-- Tab bar -->
    <div class="browser-tabs">
      <div class="browser-tab active">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        Links
      </div>
    </div>
    <!-- URL bar -->
    <div class="browser-chrome">
      <div class="browser-nav-btns">
        <button class="browser-nav-btn" disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="browser-nav-btn" disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <button class="browser-nav-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M1 20a9.97 9.97 0 0 1 2.93-7.07A9.97 9.97 0 0 1 11 10h12"/></svg>
        </button>
      </div>
      <div class="browser-url-bar">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span class="browser-url">https://denopscode-portfolio.vercel.app/links</span>
      </div>
      <div class="browser-actions">
        <button class="browser-nav-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </button>
      </div>
    </div>
    <!-- Bookmarks bar -->
    <div class="browser-bookmarks">
      <span class="browser-bookmark">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        GitHub
      </span>
      <span class="browser-bookmark">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="#0077b5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        LinkedIn
      </span>
      <span class="browser-bookmark">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        Portfolio
      </span>
    </div>
    <!-- Page content -->
    <div class="browser-page">
      <div class="links-page">
        <div class="links-header">
          <div class="links-avatar">
            <svg viewBox="0 0 80 80" width="64" height="64" fill="none">
              <circle cx="40" cy="40" r="38" fill="rgba(124,58,237,0.2)" stroke="rgba(124,58,237,0.4)" stroke-width="2"/>
              <circle cx="40" cy="30" r="14" fill="rgba(167,139,250,0.6)"/>
              <ellipse cx="40" cy="62" rx="22" ry="16" fill="rgba(167,139,250,0.4)"/>
            </svg>
          </div>
          <h2 class="links-name">Joseph Mel Resty Denopol</h2>
          <p class="links-bio">Full-Stack Developer · Laravel · Flutter · Nuxt.js</p>
        </div>
        <div class="links-list">
          <a href="https://github.com/hysterix5" class="link-card" target="_blank" rel="noopener">
            <div class="link-icon" style="background:rgba(255,255,255,0.08);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </div>
            <div class="link-info">
              <span class="link-name">GitHub</span>
              <span class="link-desc">Check out my code & open source contributions</span>
            </div>
            <svg class="link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/joseph-denopol-ba507a308/" class="link-card" target="_blank" rel="noopener">
            <div class="link-icon" style="background:rgba(0,119,181,0.15);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#0077b5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </div>
            <div class="link-info">
              <span class="link-name">LinkedIn</span>
              <span class="link-desc">Connect with me professionally</span>
            </div>
            <svg class="link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="mailto:denopolred@gmail.com" class="link-card" target="_blank" rel="noopener">
            <div class="link-icon" style="background:rgba(233,84,32,0.15);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e95420" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </div>
            <div class="link-info">
              <span class="link-name">Email</span>
              <span class="link-desc">denopolred@gmail.com</span>
            </div>
            <svg class="link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="tel:+639984807409" class="link-card" target="_blank" rel="noopener">
            <div class="link-icon" style="background:rgba(34,197,94,0.15);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="link-info">
              <span class="link-name">Phone</span>
              <span class="link-desc">+639984807409</span>
            </div>
            <svg class="link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="/resume-joseph.pdf" download="Resume_Joseph.pdf" class="link-card">
            <div class="link-icon" style="background:rgba(124,58,237,0.15);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div class="link-info">
              <span class="link-name">Resume / CV</span>
              <span class="link-desc">Download my resume (PDF)</span>
            </div>
            <svg class="link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .browser-body {
    display: flex;
    flex-direction: column;
    background: #0d1117;
  }

  /* Tabs */
  .browser-tabs {
    display: flex;
    background: rgba(15,15,28,0.95);
    padding: 0 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .browser-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    font-size: 11.5px;
    color: var(--text-secondary);
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  .browser-tab.active {
    color: var(--text-primary);
    border-bottom-color: var(--accent-primary);
    background: rgba(255,255,255,0.03);
  }

  /* Chrome */
  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: rgba(13,17,23,0.9);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .browser-nav-btns {
    display: flex;
    gap: 2px;
  }

  .browser-nav-btn {
    padding: 4px;
    border: none;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 4px;
    display: flex;
    align-items: center;
    transition: all var(--transition-fast);
  }

  .browser-nav-btn:hover:not(:disabled) {
    background: rgba(255,255,255,0.06);
    color: var(--text-secondary);
  }

  .browser-nav-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .browser-url-bar {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 12px;
  }

  .browser-url {
    color: var(--text-secondary);
  }

  .browser-actions {
    display: flex;
  }

  /* Bookmarks */
  .browser-bookmarks {
    display: flex;
    gap: 4px;
    padding: 4px 12px;
    background: rgba(13,17,23,0.6);
    border-bottom: 1px solid rgba(255,255,255,0.04);
    overflow-x: auto;
  }

  .browser-bookmark {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: var(--text-muted);
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .browser-bookmark:hover {
    background: rgba(255,255,255,0.06);
    color: var(--text-secondary);
  }

  /* Page */
  .browser-page {
    flex: 1;
    overflow-y: auto;
    background: linear-gradient(180deg, #0d1117 0%, #161b22 100%);
  }

  .links-page {
    max-width: 480px;
    margin: 0 auto;
    padding: 32px 20px;
  }

  .links-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .links-avatar {
    margin-bottom: 12px;
  }

  .links-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .links-bio {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .links-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .link-card:hover {
    background: rgba(124, 58, 237, 0.08);
    border-color: rgba(124, 58, 237, 0.2);
    transform: translateX(4px);
  }

  .link-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--text-primary);
  }

  .link-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .link-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .link-desc {
    font-size: 11.5px;
    color: var(--text-muted);
  }

  .link-arrow {
    color: var(--text-muted);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--transition-fast);
  }

  .link-card:hover .link-arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>

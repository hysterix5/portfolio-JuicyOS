   • Built a Vices Regulation Information System using Laravel & Nuxt.js
   • Digitized regulatory tracking for public sector compliance
   • Collaborated with cross-functional team on system deployments`,

      neofetch:
        () => `<span class="ascii-art">       .--.        </span> <span class="output-highlight">joseph@juicyos</span>
<span class="ascii-art">      |o_o |       </span> <span class="output-info">───────────────</span>
<span class="ascii-art">      |:_/ |       </span> <span class="output-info">OS:</span>      JuicyOS 1.0 (Linux)
<span class="ascii-art">     //   \\ \\      </span> <span class="output-info">Host:</span>    Portfolio v1.0
<span class="ascii-art">    (|     | )     </span> <span class="output-info">Kernel:</span>  6.1.0-juicy
<span class="ascii-art">   /'\\_   _/\`\\    </span> <span class="output-info">Shell:</span>   juicy-bash 5.2
<span class="ascii-art">   \\___)=(___/    </span> <span class="output-info">DE:</span>      JuicyDE (GNOME-like)
                   <span class="output-info">Theme:</span>   macOS-Inspired Dark
                   <span class="output-info">Icons:</span>   Papirus-Dark
                   <span class="output-info">WM:</span>      JuicyWM
                   <span class="output-info">CPU:</span>     Creativity × ∞
                   <span class="output-info">Memory:</span>  Unlimited Ideas`,

      date: () => {
        const now = new Date();
        return `<span class="output-text">${now.toString()}</span>`;
      },

      clear: () => "__CLEAR__",
    };

    const commandHistory: string[] = [];
    let historyIndex = -1;

    // Welcome message on first open
    let hasShownWelcome = false;

    document.addEventListener("open-app", (e) => {
      const { app } = (e as CustomEvent).detail;
      if (app === "terminal" && !hasShownWelcome) {
        hasShownWelcome = true;
        setTimeout(() => {
          addOutput(`<span class="output-highlight">Welcome to JuicyOS Terminal v1.0</span>
<span class="output-text">Type </span><span class="output-info">help</span><span class="output-text"> to see available commands.</span>
`);
          input.focus();
        }, 350);
      }
    });

    function addOutput(html: string) {
      const div = document.createElement("div");
      div.className = "line";
      div.innerHTML = html;
      output!.appendChild(div);
      output!.scrollTop = output!.scrollHeight;
    }

    function addCommandLine(cmd: string) {
      addOutput(
        `<span class="cmd-line"><span class="prompt-user">joseph</span><span class="prompt-at">@</span><span class="prompt-host">juicyos</span><span class="prompt-colon">:</span><span class="prompt-dir">~</span><span class="prompt-symbol">$</span> <span class="cmd-text">${escapeHtml(cmd)}</span></span>`,
      );
    }

    function escapeHtml(text: string) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function processCommand(raw: string) {
      const trimmed = raw.trim();
      addCommandLine(raw);

      if (!trimmed) return;

      commandHistory.unshift(trimmed);
      historyIndex = -1;

      const parts = trimmed.split(/\s+/);
      const cmd = parts[0].toLowerCase();
      const args = parts.slice(1);

      if (cmd === "echo") {
        addOutput(
          `<span class="output-text">${escapeHtml(args.join(" "))}</span>`,
        );
        return;
      }

      const handler = commands[cmd];
      if (handler) {
        const result = handler();
        if (result === "__CLEAR__") {
          output!.innerHTML = "";
        } else {
          addOutput(result);
        }
      } else {
        addOutput(`<span class="output-error">Command not found: ${escapeHtml(cmd)}</span>
<span class="output-text">Type </span><span class="output-info">help</span><span class="output-text"> for available commands.</span>`);
      }

      // Add blank line after output
      addOutput("");
    }

    input.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        processCommand(input.value);
        input.value = "";
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          input.value = commandHistory[historyIndex];
        }
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          input.value = commandHistory[historyIndex];
        } else {
          historyIndex = -1;
          input.value = "";
        }
      } else if (e.key === "l" && e.ctrlKey) {
        e.preventDefault();
        output!.innerHTML = "";
      }
    });
  }

  initTerminal();
</script>

<span class="output-warn">Tip:</span> Open the <span class="output-accent">Browser</span> app for clickable links!`,

      education:
        () => `<span class="output-highlight">━━━ Education ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</span>


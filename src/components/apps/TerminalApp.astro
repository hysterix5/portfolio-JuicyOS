  <span class="output-info">skills</span>      — Technical skills
  <span class="output-info">projects</span>    — Featured projects
  <span class="output-info">contact</span>     — Get in touch
  <span class="output-info">socials</span>     — Social media links
  <span class="output-info">education</span>   — Education background
  <span class="output-info">experience</span>  — Work experience
  <span class="output-info">neofetch</span>    — System info
  <span class="output-info">clear</span>       — Clear terminal
  <span class="output-info">date</span>        — Current date/time
  <span class="output-info">echo</span>        — Echo a message`,


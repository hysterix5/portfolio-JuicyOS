---
/* Terminal App — Interactive "About Me" terminal */
---

<div
  class="os-window closed"
  id="win-terminal"
  data-app="terminal"
  style="width:700px;height:460px;"
>
  <div class="window-titlebar">
    <div class="window-controls">
      <button class="win-close"
        ><svg viewBox="0 0 12 12" stroke="currentColor" stroke-width="2"
          ><line x1="3" y1="3" x2="9" y2="9"></line><line
            x1="9"
            y1="3"
            x2="3"
            y2="9"></line></svg
        ></button
      >
      <button class="win-minimize"
        ><svg viewBox="0 0 12 12" stroke="currentColor" stroke-width="2"
          ><line x1="2" y1="6" x2="10" y2="6"></line></svg
        ></button
      >
      <button class="win-maximize"
        ><svg viewBox="0 0 12 12" stroke="currentColor" stroke-width="1.5"
          ><rect x="2" y="2" width="8" height="8" rx="1" fill="none"
          ></rect></svg
        ></button
      >
    </div>
    <span class="window-title">joseph@juicyos: ~</span>
    <div class="window-title-spacer"></div>
  </div>
  <div class="window-body terminal-body" id="terminal-body">
    <div class="terminal-output" id="terminal-output"></div>
    <div class="terminal-input-line">
      <span class="terminal-prompt">
        <span class="prompt-user">joseph</span><span class="prompt-at">@</span
        ><span class="prompt-host">juicyos</span><span class="prompt-colon"
          >:</span
        ><span class="prompt-dir">~</span><span class="prompt-symbol">$</span>
      </span>
      <input
        type="text"
        class="terminal-input"
        id="terminal-input"
        autocomplete="off"
        spellcheck="false"
        autofocus
      />
      <span class="terminal-cursor"></span>
    </div>
  </div>
</div>

<style>
  .terminal-body {
    background: var(--term-bg);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    color: var(--term-text);
    cursor: text;
  }

  .terminal-output {
    flex: 1;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .terminal-output .line {
    animation: bootLine 0.1s ease forwards;
  }

  .terminal-output .cmd-line {
    color: var(--term-text);
  }

  .terminal-output .cmd-line .prompt-user {
    color: var(--term-green);
    font-weight: 700;
  }
  .terminal-output .cmd-line .prompt-at {
    color: var(--term-text);
  }
  .terminal-output .cmd-line .prompt-host {
    color: var(--term-blue);
    font-weight: 700;
  }
  .terminal-output .cmd-line .prompt-colon {
    color: var(--term-text);
  }
  .terminal-output .cmd-line .prompt-dir {
    color: var(--term-purple);
    font-weight: 700;
  }
  .terminal-output .cmd-line .prompt-symbol {
    color: var(--term-text);
    margin-right: 8px;
  }
  .terminal-output .cmd-line .cmd-text {
    color: var(--term-text);
  }

  .terminal-output .output-text {
    color: var(--term-text);
    opacity: 0.85;
  }
  .terminal-output .output-highlight {
    color: var(--term-green);
  }
  .terminal-output .output-info {
    color: var(--term-blue);
  }
  .terminal-output .output-warn {
    color: var(--term-yellow);
  }
  .terminal-output .output-error {
    color: var(--term-red);
  }
  .terminal-output .output-accent {
    color: var(--term-purple);
  }
  .terminal-output .output-cyan {
    color: var(--term-cyan);
  }

  .terminal-output .ascii-art {
    color: var(--term-green);
    font-size: 10px;
    line-height: 1.2;
    margin: 4px 0;
  }

  .terminal-input-line {
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 24px;
    flex-shrink: 0;
  }

  .terminal-prompt {
    display: flex;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .prompt-user {
    color: var(--term-green);
    font-weight: 700;
  }
  .prompt-at {
    color: var(--term-text);
  }
  .prompt-host {
    color: var(--term-blue);
    font-weight: 700;
  }
  .prompt-colon {
    color: var(--term-text);
  }
  .prompt-dir {
    color: var(--term-purple);
    font-weight: 700;
  }
  .prompt-symbol {
    color: var(--term-text);
    margin-right: 8px;
  }

  .terminal-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--term-text);
    font-family: var(--font-mono);
    font-size: 13px;
    caret-color: var(--term-green);
    padding: 0;
  }

  .terminal-cursor {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: var(--term-green);
    animation: cursorBlink 1s step-end infinite;
    margin-left: -1px;
    opacity: 0.8;
  }

  .terminal-input:focus ~ .terminal-cursor {
    opacity: 1;
  }
</style>

<script>
  function initTerminal() {
    const output = document.getElementById("terminal-output");
    const input = document.getElementById("terminal-input") as HTMLInputElement;
    const body = document.getElementById("terminal-body");
    if (!output || !input || !body) return;

    // Click anywhere in terminal to focus input
    body.addEventListener("click", () => input.focus());

    const commands: Record<string, () => string> = {
      help: () => `<span class="output-highlight">Available commands:</span>


    const tabs = document.querySelectorAll(".editor-tab");
    const treeFiles = document.querySelectorAll(".tree-file");
    const titleEl = document.querySelector("#win-editor .window-title");
    const langEl = document.getElementById("editor-lang");
    const linesEl = document.getElementById("editor-lines");

    if (!codeArea) return;

    const files: Record<string, { content: string; lang: string }> = {
      resume: {
        lang: "Markdown",
        content: `# Joseph Mel Resty Denopol — Full-Stack Developer


  for government compliance
- Built with Laravel and Nuxt.js
- Digitized regulatory tracking for
  public sector compliance`,
      },
    };

    function syntaxHighlight(content: string, lang: string): string {
      const lines = content.split("\n");
      return lines
        .map((line, i) => {
          let highlighted = escapeHtml(line);

          if (lang === "Markdown") {
            if (line.startsWith("# "))
              highlighted = `<span class="syn-heading">${escapeHtml(line)}</span>`;
            else if (line.startsWith("## "))
              highlighted = `<span class="syn-heading2">${escapeHtml(line)}</span>`;
            else if (line.startsWith("### "))
              highlighted = `<span class="syn-heading3">${escapeHtml(line)}</span>`;
            else if (line.startsWith("---"))
              highlighted = `<span class="syn-separator">${escapeHtml(line)}</span>`;
            else if (line.startsWith("- **")) {
              highlighted = highlighted.replace(
                /- \*\*(.*?)\*\*/,
                '<span class="syn-bullet">-</span> <span class="syn-bold">$1</span>',
              );
            } else if (line.startsWith("- ") || line.startsWith("→ "))
              highlighted = `<span class="syn-bullet">${escapeHtml(line.slice(0, 2))}</span>${escapeHtml(line.slice(2))}`;
            else if (line.startsWith("*"))
              highlighted = `<span class="syn-comment">${escapeHtml(line)}</span>`;

            // Inline bold
            highlighted = highlighted.replace(
              /\*\*(.*?)\*\*/g,
              '<span class="syn-bold">$1</span>',
            );
            // Emojis and links stay as-is
          } else if (lang === "JSON") {
            // Keys
            highlighted = highlighted.replace(
              /"([^"]+)":/g,
              '<span class="syn-key">"$1"</span>:',
            );
            // String values
            highlighted = highlighted.replace(
              /: "([^"]+)"/g,
              ': <span class="syn-string">"$1"</span>',
            );
            // Standalone strings in arrays
            highlighted = highlighted.replace(
              /^\s+"([^"]+)"(,?)$/gm,
              (match) => {
                return match.replace(
                  /"([^"]+)"/g,
                  '<span class="syn-string">"$1"</span>',
                );
              },
            );
            // Brackets
            highlighted = highlighted.replace(
              /([{}\[\]])/g,
              '<span class="syn-bracket">$1</span>',
            );
          } else if (lang === "YAML") {
            if (line.trimStart().startsWith("#"))
              highlighted = `<span class="syn-comment">${escapeHtml(line)}</span>`;
            else if (line.match(/^\s*- /)) {
              highlighted = highlighted.replace(
                /^(\s*)- /,
                '$1<span class="syn-bullet">- </span>',
              );
            }
            // Keys
            highlighted = highlighted.replace(
              /^(\s*)([a-zA-Z_]+):/gm,
              '$1<span class="syn-key">$2</span>:',
            );
            // Quoted strings
            highlighted = highlighted.replace(
              /"([^"]+)"/g,
              '<span class="syn-string">"$1"</span>',
            );
          }

          return `<div class="code-line"><span class="line-num">${i + 1}</span><span class="line-content">${highlighted}</span></div>`;
        })
        .join("");
    }

    function escapeHtml(text: string) {
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    function showFile(fileId: string) {
      const file = files[fileId];
      if (!file) return;

      codeArea!.innerHTML = syntaxHighlight(file.content, file.lang);

      // Update tabs
      tabs.forEach((t) =>
        t.classList.toggle(
          "active",
          (t as HTMLElement).dataset.file === fileId,
        ),
      );
      treeFiles.forEach((t) =>
        t.classList.toggle(
          "active",
          (t as HTMLElement).dataset.file === fileId,
        ),
      );

      // Update status bar
      if (langEl) langEl.textContent = file.lang;
      if (linesEl) {
        const lineCount = file.content.split("\n").length;
        linesEl.textContent = `Ln 1, Col 1 · ${lineCount} lines`;
      }

      // Update title
      const fileName =
        fileId === "resume"
          ? "resume.md"
          : fileId === "skills"
            ? "skills.json"
            : fileId === "experience"
              ? "experience.yml"
              : "education.md";
      if (titleEl) titleEl.textContent = `JuicyCode — ${fileName}`;
    }

    // Tab & tree click handlers
    tabs.forEach((t) => {
      t.addEventListener("click", () => {
        const file = (t as HTMLElement).dataset.file;
        if (file) showFile(file);
      });
    });

    treeFiles.forEach((t) => {
      t.addEventListener("click", () => {
        const file = (t as HTMLElement).dataset.file;
        if (file) showFile(file);
      });
    });

    // Show resume by default
    showFile("resume");
  }

  initEditor();
</script>

---
/* Top Panel — System bar at the top of the desktop */
---

<div id="top-panel" class="glass-heavy">
  <div class="panel-left">
    <button class="panel-btn activities-btn" id="activities-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="3" y="14" width="7" height="7" rx="1"/>
        <rect x="14" y="14" width="7" height="7" rx="1"/>
      </svg>
      Activities
    </button>
  </div>
  <div class="panel-center">
    <span class="panel-clock" id="panel-clock"></span>
  </div>
  <div class="panel-right">
    <div class="tray-group">
      <!-- Wi-Fi -->
      <div class="tray-icon" title="Wi-Fi: Connected">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
          <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
          <circle cx="12" cy="20" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </div>
      <!-- Volume -->
      <div class="tray-icon" title="Volume: 75%">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" opacity="0.3"/>
          <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
        </svg>
      </div>
      <!-- Battery -->
      <div class="tray-icon" title="Battery: 92%">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <rect x="1" y="6" width="18" height="12" rx="2"/>
          <rect x="3" y="8" width="13" height="8" rx="1" fill="var(--accent-green)" opacity="0.5" stroke="none"/>
          <line x1="23" y1="10" x2="23" y2="14"/>
        </svg>
      </div>
    </div>
    <button class="panel-btn power-btn" id="power-btn" title="Power">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18.36 6.64a9 9 0 1 1-12.73 0"/>
        <line x1="12" y1="2" x2="12" y2="12"/>
      </svg>
    </button>
  </div>
</div>

<style>
  #top-panel {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--panel-height);
    z-index: var(--z-panel);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    background: var(--panel-bg);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    box-shadow: var(--shadow-panel);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  #top-panel.visible {
    opacity: 1;
  }

  .panel-left,
  .panel-center,
  .panel-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .panel-left {
    flex: 1;
  }

  .panel-center {
    flex: 0 0 auto;
  }

  .panel-right {
    flex: 1;
    justify-content: flex-end;
  }

  .panel-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .panel-btn:hover {
    background: rgba(255,255,255,0.08);
  }

  .panel-clock {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: 0.2px;
  }

  .tray-group {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 6px;
    transition: background var(--transition-fast);
  }

  .tray-group:hover {
    background: rgba(255,255,255,0.06);
  }

  .tray-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    padding: 2px;
  }

  .power-btn {
    padding: 3px 6px;
  }

  .power-btn:hover {
    color: var(--accent-red);
    background: rgba(239, 68, 68, 0.1);
  }
</style>

<script>
  function initPanel() {
    const panel = document.getElementById('top-panel');
    const clockEl = document.getElementById('panel-clock');
    if (!panel || !clockEl) return;

    function updateClock() {
      const now = new Date();
      const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: true });
      const date = now.toLocaleDateString([], { month: 'short', day: 'numeric' });
      clockEl!.textContent = `${date}  ${time}`;
    }
    updateClock();
    setInterval(updateClock, 1000);

    document.addEventListener('login-complete', () => {
      panel.classList.add('visible');
    });
  }
  initPanel();
</script>

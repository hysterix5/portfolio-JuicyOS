---
/**
 * Window Manager — Handles all window operations:
 * dragging, focusing, minimizing, maximizing, closing
 * 
 * This component contains the JS logic that manages all windows.
 * Individual Window components register themselves.
 */
---

<script>
  // ========================================
  // JuicyOS Window Manager
  // ========================================

  interface WindowState {
    id: string;
    app: string;
    el: HTMLElement;
    isOpen: boolean;
    isMinimized: boolean;
    isMaximized: boolean;
    zIndex: number;
    position: { x: number; y: number };
    size: { w: number; h: number };
    savedPosition?: { x: number; y: number };
    savedSize?: { w: number; h: number };
  }

  const windowStates: Map<string, WindowState> = new Map();
  let topZ = 100;

  // Register a window
  function registerWindow(el: HTMLElement) {
    const id = el.id;
    const app = el.dataset.app || id;
    const state: WindowState = {
      id, app, el,
      isOpen: false,
      isMinimized: false,
      isMaximized: false,
      zIndex: topZ,
      position: { x: 0, y: 0 },
      size: { w: 0, h: 0 },
    };
    windowStates.set(id, state);
  }

  // Focus a window
  function focusWindow(id: string) {
    const state = windowStates.get(id);
    if (!state) return;
    topZ++;
    state.zIndex = topZ;
    state.el.style.zIndex = String(topZ);
    state.el.classList.add('focused');
    // Remove focus from others
    windowStates.forEach((s, key) => {
      if (key !== id) s.el.classList.remove('focused');
    });
  }

  // Open a window by app name
  function openWindow(app: string) {
    const state = Array.from(windowStates.values()).find(s => s.app === app);
    if (!state) return;

    if (state.isOpen && state.isMinimized) {
      // Restore from minimized
      state.isMinimized = false;
      state.el.classList.remove('minimized');
      state.el.classList.add('open');
      focusWindow(state.id);
      notifyState(state.app, 'open');
      return;
    }

    if (state.isOpen) {
      focusWindow(state.id);
      return;
    }

    state.isOpen = true;
    state.isMinimized = false;

    // Calculate centered position with offset for each window
    const workspace = document.getElementById('desktop-workspace');
    if (workspace) {
      const ww = workspace.clientWidth;
      const wh = workspace.clientHeight;
      const winW = Math.min(state.el.offsetWidth || 750, ww - 60);
      const winH = Math.min(state.el.offsetHeight || 500, wh - 60);
      const index = Array.from(windowStates.values()).filter(s => s.isOpen).length;
      const offset = (index - 1) * 30;
      state.position.x = Math.max(20, (ww - winW) / 2 + offset);
      state.position.y = Math.max(20, (wh - winH) / 2 + offset);
      state.el.style.left = state.position.x + 'px';
      state.el.style.top = state.position.y + 'px';
    }

    state.el.classList.add('open');
    state.el.classList.remove('closed', 'minimized');
    focusWindow(state.id);
    notifyState(state.app, 'open');
  }

  // Minimize a window
  function minimizeWindow(id: string) {
    const state = windowStates.get(id);
    if (!state) return;
    state.isMinimized = true;
    state.el.classList.add('minimized');
    state.el.classList.remove('focused');
    notifyState(state.app, 'minimized');
  }

  // Maximize / restore a window
  function toggleMaximize(id: string) {
    const state = windowStates.get(id);
    if (!state) return;

    if (state.isMaximized) {
      // Restore
      state.isMaximized = false;
      state.el.classList.remove('maximized');
      if (state.savedPosition) {
        state.el.style.left = state.savedPosition.x + 'px';
        state.el.style.top = state.savedPosition.y + 'px';
      }
      if (state.savedSize) {
        state.el.style.width = state.savedSize.w + 'px';
        state.el.style.height = state.savedSize.h + 'px';
      }
    } else {
      // Save current & maximize
      state.savedPosition = { ...state.position };
      state.savedSize = { w: state.el.offsetWidth, h: state.el.offsetHeight };
      state.isMaximized = true;
      state.el.classList.add('maximized');
      state.el.style.left = '0';
      state.el.style.top = '0';
      state.el.style.width = '100%';
      state.el.style.height = '100%';
    }
    focusWindow(id);
  }

  // Close a window
  function closeWindow(id: string) {
    const state = windowStates.get(id);
    if (!state) return;
    state.el.classList.add('closing');
    setTimeout(() => {
      state.isOpen = false;
      state.isMinimized = false;
      state.isMaximized = false;
      state.el.classList.remove('open', 'closing', 'maximized', 'focused');
      state.el.classList.add('closed');
      notifyState(state.app, 'closed');
    }, 250);
  }

  function notifyState(app: string, state: string) {
    document.dispatchEvent(new CustomEvent('window-state-change', { detail: { app, state } }));
  }

  // Dragging
  function initDrag(windowEl: HTMLElement) {
    const titlebar = windowEl.querySelector('.window-titlebar') as HTMLElement;
    if (!titlebar) return;

    let isDragging = false;
    let startX = 0, startY = 0, origX = 0, origY = 0;

    titlebar.addEventListener('mousedown', (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('.window-controls')) return;
      const state = windowStates.get(windowEl.id);
      if (!state || state.isMaximized) return;

      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      origX = windowEl.offsetLeft;
      origY = windowEl.offsetTop;
      focusWindow(windowEl.id);
      windowEl.classList.add('dragging');
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      const newX = origX + dx;
      const newY = origY + dy;
      windowEl.style.left = newX + 'px';
      windowEl.style.top = Math.max(0, newY) + 'px';
      const state = windowStates.get(windowEl.id);
      if (state) {
        state.position.x = newX;
        state.position.y = Math.max(0, newY);
      }
    });

    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        windowEl.classList.remove('dragging');
      }
    });
  }

  // Initialize all windows
  function initWindowManager() {
    const windows = document.querySelectorAll('.os-window');
    windows.forEach(w => {
      const el = w as HTMLElement;
      registerWindow(el);
      initDrag(el);

      // Click to focus
      el.addEventListener('mousedown', () => focusWindow(el.id));

      // Title bar button handlers
      const closeBtn = el.querySelector('.win-close');
      const minBtn = el.querySelector('.win-minimize');
      const maxBtn = el.querySelector('.win-maximize');

      closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); closeWindow(el.id); });
      minBtn?.addEventListener('click', (e) => { e.stopPropagation(); minimizeWindow(el.id); });
      maxBtn?.addEventListener('click', (e) => { e.stopPropagation(); toggleMaximize(el.id); });

      // Double-click titlebar to maximize
      const titlebar = el.querySelector('.window-titlebar');
      titlebar?.addEventListener('dblclick', () => toggleMaximize(el.id));
    });

    // Listen for open-app events from dock
    document.addEventListener('open-app', (e: Event) => {
      const { app } = (e as CustomEvent).detail;
      openWindow(app);
    });
  }

  // Wait for DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWindowManager);
  } else {
    initWindowManager();
  }
</script>

<style is:global>
  /* ================================================
     Window Base Styles (shared by all windows)
     ================================================ */
  .os-window {
    position: absolute;
    border-radius: var(--window-radius);
    background: var(--window-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--shadow-window);
    overflow: hidden;
    display: none;
    flex-direction: column;
    min-width: 380px;
    min-height: 280px;
    transition: box-shadow 0.2s;
  }

  .os-window.open {
    display: flex;
    animation: windowOpen 0.3s var(--ease-spring) forwards;
  }

  .os-window.closing {
    animation: windowClose 0.25s var(--ease-out) forwards;
  }

  .os-window.minimized {
    animation: windowMinimize 0.3s var(--ease-out) forwards;
    pointer-events: none;
  }

  .os-window.closed {
    display: none;
  }

  .os-window.maximized {
    border-radius: 0;
    transition: all 0.3s var(--ease-out);
  }

  .os-window.focused {
    box-shadow: var(--shadow-window), 0 0 0 1px rgba(124, 58, 237, 0.15);
  }

  .os-window.dragging {
    opacity: 0.92;
    cursor: grabbing;
  }

  /* Title bar */
  .window-titlebar {
    display: flex;
    align-items: center;
    height: var(--window-titlebar-height);
    padding: 0 14px;
    background: var(--window-titlebar);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    cursor: grab;
    flex-shrink: 0;
    gap: 10px;
  }

  .os-window.dragging .window-titlebar {
    cursor: grabbing;
  }

  /* Traffic light buttons */
  .window-controls {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
  }

  .window-controls button {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    position: relative;
    transition: filter 0.15s;
  }

  .window-controls button:hover {
    filter: brightness(1.3);
  }

  .window-controls button svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 7px;
    height: 7px;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .window-controls:hover button svg {
    opacity: 1;
  }

  .win-close {
    background: #ff5f57;
  }

  .win-minimize {
    background: #ffbd2e;
  }

  .win-maximize {
    background: #28c840;
  }

  .win-close svg { color: #4a0002; }
  .win-minimize svg { color: #6b4e00; }
  .win-maximize svg { color: #006500; }

  /* Unfocused state — dim buttons */
  .os-window:not(.focused) .window-controls button {
    background: rgba(255,255,255,0.12);
  }

  .window-title {
    flex: 1;
    text-align: center;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    pointer-events: none;
  }

  .window-title-spacer {
    width: 62px;
    flex-shrink: 0;
  }

  /* Window content */
  .window-body {
    flex: 1;
    overflow: auto;
    position: relative;
  }

  @media (max-width: 768px) {
    .os-window {
      min-width: 300px;
      min-height: 220px;
    }
    .os-window.open {
      width: calc(100% - 16px) !important;
      left: 8px !important;
    }
  }
</style>
